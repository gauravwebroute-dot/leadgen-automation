# PostgreSQL connection (local docker-compose defaults shown)
DATABASE_URL=postgresql+psycopg2://leadgen:leadgen@localhost:5432/leadgen

# Company discovery provider: "outscraper", "serpapi", or "places"
COMPANY_DISCOVERY_PROVIDER=outscraper

# Outscraper -- outscraper.com, free monthly credits for testing
OUTSCRAPER_API_KEY=

# SerpApi -- serpapi.com, free tier: 100 searches/month
SERPAPI_API_KEY=

# Google Places API (New) -- company discovery (name, address, phone, website)
# Enable at: console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=

# Google Custom Search JSON API -- contact discovery only (LinkedIn)
# When creating the search engine at programmablesearchengine.google.com,
# set "Sites to search" to linkedin.com -- "search the entire web" is no
# longer available for new engines as of Jan 2026.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Hunter.io Email Verifier -- confirms guessed emails are real before they're
# trusted. Free tier: hunter.io (50 credits/month, ~100 verifications)
HUNTER_API_KEY=

# Odoo XML-RPC credentials
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
